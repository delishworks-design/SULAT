<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_background"
    android:layout_marginBottom="8dp"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvRecipientNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Recipient 1"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/deep_green" />

            <Button
                android:id="@+id/btnDeleteRecipient"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Delete"
                android:textSize="12sp"
                android:textColor="#D32F2F" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name *"
            android:textSize="12sp"
            android:textColor="@color/muted_text"
            android:layout_marginBottom="2dp" />

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="e.g. KA. JUAN DELA CRUZ"
            android:textSize="14sp"
            android:paddingHorizontal="8dp"
            android:background="@color/warm_white"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Position"
            android:textSize="12sp"
            android:textColor="@color/muted_text"
            android:layout_marginBottom="2dp" />

        <EditText
            android:id="@+id/etPosition"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="e.g. Minister"
            android:textSize="14sp"
            android:paddingHorizontal="8dp"
            android:background="@color/warm_white"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Organization"
            android:textSize="12sp"
            android:textColor="@color/muted_text"
            android:layout_marginBottom="2dp" />

        <EditText
            android:id="@+id/etOrganization"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="e.g. Local Congregation"
            android:textSize="14sp"
            android:paddingHorizontal="8dp"
            android:background="@color/warm_white"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Address"
            android:textSize="12sp"
            android:textColor="@color/muted_text"
            android:layout_marginBottom="2dp" />

        <EditText
            android:id="@+id/etAddress"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:hint="Street, City, Province"
            android:textSize="14sp"
            android:paddingHorizontal="8dp"
            android:paddingTop="8dp"
            android:background="@color/warm_white"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Optional Information"
            android:textSize="12sp"
            android:textColor="@color/muted_text"
            android:layout_marginBottom="2dp" />

        <EditText
            android:id="@+id/etOptional"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Any additional details"
            android:textSize="14sp"
            android:paddingHorizontal="8dp"
            android:paddingTop="8dp"
            android:background="@color/warm_white"
            android:gravity="top"
            android:inputType="textMultiLine" />
    </LinearLayout>
</ScrollView>
